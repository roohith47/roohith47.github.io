---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resume | Rohith Kumar Tappa">
  <main>
    <h1>Resume</h1>

    <p>
      <a href="/resume.pdf" target="_blank" rel="noreferrer">Open resume (PDF)</a>
      ·
      <a href="/resume.pdf" download>Download</a>
    </p>

    <iframe
      src="/resume.pdf"
      width="100%"
      height="900"
      style="border: 3px solid #ffd60a; border-radius: 0; box-shadow: 0 8px 0 rgba(0,0,0,0.2), 2px 2px 0 rgba(114,9,183,0.4);"
    ></iframe>
  </main>
</Layout>
